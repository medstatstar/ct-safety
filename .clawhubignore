# ============================================================
# ct-safety packaging exclusions for ClawHub publish.
# Mirror of .gitignore. The ClawHub packager uses this file to
# decide what to strip from the published package. Goal: never
# ship an openFDA API key or runtime caches/outputs.
# ============================================================

# ---- Secrets / API keys (NEVER ship) ----
.env
*.env
.env.*
*.key
*.secret
*.token
secrets.json
credentials.json
config.local.json

# ---- Runtime caches / downloaded outputs (not part of the skill) ----
out/
out_live/
*.cache
faers_summary_cache.json
faers_*.json
faers_*.csv
faers_*.xlsx
cn_pv.json
*.jsonl

# ---- Python cruft ----
__pycache__/
*.pyc

# ---- Dev-only test harness (NOT shipped to runtime package) ----
# The `tests/` directory uses importlib.util.exec_module / __import__ to
# discover and load test modules. ClawHub's static scanner flags this as
# `suspicious.dynamic_code_execution` (false positive — it is stdlib module
# loading, not arbitrary-code execution). Tests are dev assets: kept in the
# GitHub repo for transparency, but STRIPPED from the ClawHub package so the
# published runtime surface stays clean. (.gitignore intentionally keeps tests
# so the repo remains auditable.)
tests/
tests/**
diagnose_rounds.py
